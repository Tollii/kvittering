# Filled by `bunx convex dev` in .env.local
CONVEX_DEPLOYMENT=dev:your-deployment
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Local source values for scripts/configure_development.ts.
# The script copies these to the DEVELOPMENT Convex deployment.
BETTER_AUTH_SECRET=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
RECEIPT_SITE_URL=http://localhost:5180

# Optional local provider verification overrides.
OPENAI_RECEIPT_MODEL=gpt-5.6-luna
TYPESAFE_MODEL=jev-latest
