{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  // Scripts are ordered by workflow, not by name.
  "sortPackageJson": false,
  "ignorePatterns": [
    // Generated files, dependencies, and build output.
    "node_modules",
    ".expo",
    ".convex",
    "expo-env.d.ts",
    "convex/_generated",
    "convex/kassalapp/generated",
    "package-lock.json",
    "assets",
    "api/kassalapp.openapi.json",
    "ios",
    "android",
    "dist",
    "build",
    "coverage",
    // External rules, agent assets, and archived review material.
    "tools/oxlint/anti-slop",
    ".agents",
    ".claude",
    ".codex",
    "plans",
    "convex/contract.json",
  ],
}
