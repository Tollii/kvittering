{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Expo loads config plugins by path from app.json; ESLint and Oxlint load rules by path.
  // Stryker runs the mutation test config from a command string.
  "entry": ["plugins/*.js", "tools/eslint/*.cjs", "vitest.mutation.config.mts"],
  // Vendored rule source and rule-test fixtures are not application code.
  "ignore": ["tools/oxlint/anti-slop/**", "tools/eslint/fixtures/**"],
  // expo-router's native tabs require this peer at runtime without an import.
  // Stryker core bundles its command runner under this name.
  "ignoreDependencies": [
    "expo-glass-effect",
    "@stryker-mutator/command-runner",
  ],
  // Report exports that nothing uses, including the defining file.
  "ignoreExportsUsedInFile": true,
}
