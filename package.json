  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "npm run lint:oxlint && npm run lint:eslint && npm run lint:unused && npm run lint:docs && npm run lint:mocks",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p tools/tsconfig.json",
    "test": "vitest run",
    "backend": "convex dev",
    "backend:staging": "node tools/release.mts backend",
    "ios:build": "expo run:ios",
    "testflight": "npm run release:check && npx eas-cli@24.7.0 build --platform ios --profile testflight --auto-submit",
    "generate:catalog": "orval",
    "update:testflight": "npm run release:check && npx eas-cli@24.7.0 update --channel testflight --environment preview --platform ios",
    "postupdate:testflight": "npm run sentry:sourcemaps",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "lint:oxlint": "oxlint --deny-warnings --format=${OXLINT_FORMAT:-default}",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:unused": "knip --no-progress",
    "lint:fix": "oxlint --fix && eslint . --fix && npm run format",
    "test:rules": "node --test tools/lint-rules/rules.test.cjs",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "e2e:ios": "tools/e2e/ios.sh",
    "visual:start": "tools/visual/start.sh",
    "contract:update": "vitest run convex/contract.test.ts --update",
    "check:fast": "npm run format:check && npm run typecheck && npm run lint && npm run lint:duplicates",
    "check:changed": "node tools/check-changed.mts",
    "check": "npm run check:fast && npm run test:rules && npm test && npm run test:components",
    "check:ci": "npm run check:fast && npm run test:rules && npm run test:coverage && npm run test:components -- --ci --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:docs": "node tools/check-docs.mts",
    "lint:mocks": "node tools/check-mock-reasons.mts",
    "test:components": "jest",
    "release:check": "node tools/release.mts client",
    "lint:duplicates": "node tools/check-duplicates.mts"
  },
  "private": true,
  "overrides": {
    "better-auth": {
      "vitest": "$vitest"
    },
    "decode-uri-component": "$decode-uri-component",
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
