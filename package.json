    "@sentry/browser": "^10.75.0",
    "@stryker-mutator/core": "^10.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^26.6.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "5.0.1",
    "babel-jest": "^29.7.0",
    "convex-test": "^0.0.59",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-plugin-sonarjs": "4.2.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^6.38.0",
    "orval": "^8.33.0",
    "oxlint": "1.83.0",
    "prettier": "^3.9.8",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "npm run lint:oxlint && npm run lint:policy && npm run lint:eslint && npm run lint:unused && npm run lint:docs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "test": "vitest run",
    "backend": "convex dev",
    "backend:staging": "convex deploy --env-file .env.staging.local",
    "ios:build": "expo run:ios",
    "testflight": "npm run backend:staging && npx eas-cli@latest build --platform ios --profile testflight --auto-submit",
    "generate:catalog": "orval",
    "update:testflight": "npm run backend:staging && npx eas-cli@24.7.0 update --channel testflight --environment preview --platform ios",
    "postupdate:testflight": "npm run sentry:sourcemaps",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:policy": "oxlint --config oxlint.policy.config.mjs --deny-warnings",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:unused": "knip --no-progress",
    "lint:fix": "oxlint --fix && oxlint --config oxlint.policy.config.mjs --fix && eslint . --fix && npm run format",
    "test:rules": "node --test tools/eslint/rules.test.cjs",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "e2e:ios": "tools/e2e/ios.sh",
    "contract:update": "vitest run convex/contract.test.ts --update",
    "check:fast": "npm run format:check && npm run typecheck && npm run lint",
    "check:changed": "node tools/check-changed.mts",
    "check": "npm run check:fast && npm run test:rules && npm test && npm run test:components",
    "check:ci": "npm run check:fast && npm run test:rules && npm run test:coverage && npm run test:components -- --ci --coverage",
    "format": "prettier --write . && oxlint --config oxlint.policy.config.mjs --allow all --deny anti-slop/require-readable-spacing --fix",
    "format:check": "prettier --check .",
    "lint:docs": "node tools/check-docs.mts",
    "test:components": "jest"
  },
  "private": true,
  "overrides": {
    "better-auth": {
      "vitest": "$vitest"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
